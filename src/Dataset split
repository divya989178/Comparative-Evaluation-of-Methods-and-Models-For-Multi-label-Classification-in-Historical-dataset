def combine_document(group):
    all_labels = [label for labels in group['label'] for label in labels]
    label_counts = Counter(all_labels)

    return pd.Series({
        'doc_id': group['doc_id'].iloc[0],
        'paragraphs': group['text'].tolist(),
        'paragraph_ids': group['id'].tolist(),
        'paragraph_labels': group['label'].tolist(),
        'label_counts': dict(label_counts),
        'num_paragraphs': len(group)
    })

docs_df = df.groupby('doc_id').apply(combine_document).reset_index(drop=True)

def frequency_matrix(docs_df, label_names):

    features = []

    for _, doc in docs_df.iterrows():
        counts = doc['label_counts']
        feature_vector = []

        for label in label_names:
            count = counts.get(label, 0)

            # Binary presence
            feature_vector.append(1 if count > 0 else 0)

            
            feature_vector.append(1 if 1 <= count <= 2 else 0)  # Low
            feature_vector.append(1 if 3 <= count <= 5 else 0)  # Medium
            feature_vector.append(1 if count >= 6 else 0)       # High

        features.append(feature_vector)

    return np.array(features)


