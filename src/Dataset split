def expand_to_paragraphs(docs):
    paragraphs = []
    for _, doc in docs.iterrows():
        for para_id, para_text, para_labels in zip(
            doc['paragraph_ids'],
            doc['paragraphs'],
            doc['paragraph_labels']
        ):
            paragraphs.append({
                'id': para_id,
                'doc_id': doc['doc_id'],
                'text': para_text,
                'labels': para_labels  # Original paragraph-level labels
            })
    return pd.DataFrame(paragraphs)

