def clean_symb(value):
    if isinstance(value, str):
       value = re.sub(r'\.{2,}', '', value)
       value = re.sub(r'/', '', value)
       value = re.sub(r'\\','',value)
       value = re.sub(r'[\[\]]','',value)
       value = re.sub(r'\(\d+[a-zA-Z]\)', '', value)
       value = re.sub(r'\(\d+\)','',value)
       return value.strip()
    return value
